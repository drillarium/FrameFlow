  <property name="styleSheet">
   <string notr="true">#centralWidget, #mainWidget, #previewWidget, #inputWidget, #outputWidget, #scrollAreaWidgetContents {
  background: #101318;
}

#footerWidget, #headerWidget, #timelineWidget, #previewFooterWidget, #previewVideoWidget,
#effectsWidget, #scenesWidget, #sourcesWidget, #transitionsWidget,
#controlsWidget, #audioMixerWidget {
  background: #171B22;
  border: 1px solid #22252D;
  border-radius: 6px;
}

QLabel {
  color: #7B899D;
}

#statusLabel {
  color: #22C35D;
}

#projectButtonWidget {
  border: 2px solid #22252D;
  border-radius: 12px;
  padding: 6px 10px;
  background-color: transparent;
}

#projectButtonWidget:hover {
  background-color: #303541;
}

#projectButtonWidget &gt; QLabel {
  color: white;
}

#titleLabel, #controlsLabel, #audioMixerLabel {
  color: white;
}

QPushButton {
  background: transparent;
}

#gotoLiveButton {
  background: #19BDDE;
  color: black;
  border: 1px solid #19BDDE;
  border-radius: 8px;
}

#gotoLiveButton:hover {
  background-color: #14A8C6;
  color: black;
}

#startRecordingButton {
  background: #171B22;
  color: white;
  border: 1px solid #647081;
  border-radius: 8px;
}

#startRecordingButton:hover {
  background-color: #1E2330;
  color: white;
}

#controlsLine {
    max-height: 1px;
    min-height: 1px;
    background-color: #647081;
    border: none;
}

#viewersCountLabel {
  color: white;
}

#streamingStatusLabel {
  background: black;
  border: 1px solid black;
  border-radius: 6px;
  padding: 2px 3px;
}


#microButton, #chatButton, #camButton {
  background: #647081;
  border: 1px solid black;
  border-radius: 10px;
  padding: 6px 6px;
}

#sceneListWidget, #sourceListWidget, #transitionListWidget, #effectListWidget {
  background: transparent;
}

#scenesLabel, #sourcesLabel, #transitionLabel, #effetsLabel {
  color: white;
}

#expandEffectButton, #expandTransitionButton {
  background: #171B22;
  color:  #647081;
  border: 0px solid white;
}

#transitionsStackedWidget, #effectsStackedWidget {
  background: #171B22;
}

#transitionsStackedWidget QWidget, #effectsStackedWidget QWidget {
    background: #171B22;
    border: 0px;
}</string>
