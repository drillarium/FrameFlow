  <property name="styleSheet">
   <string notr="true">#mainSettingsWidget {
  background: #101318;
  border-left: 1px solid white;
  border-top: none;
  border-right: none;
  border-bottom: none;
}

QLabel {
  color: white;
}

#titleLabel {
  color: white;
}

#hotkeysLabel, #streamServersLabel, #encodingLabel, #bitrateLabel {
  color: grey;
}

#addStreamServerButton {
  background:  #101318;
  color: white;
}

#addStreamServerButton:hover {
  background: grey;
  color: white;
}

#streamServersListWidgets {
    background: #101318;
}

QLineEdit {
  background: #171B22;
  color: white;
  border: 1px solid #647081;
  border-radius: 8px;
  padding-left: 8px;
}

QLineEdit:focus {
    border: 1px solid #19BDDE;
}

QComboBox {
  background: #171B22;
  color: white;
  border: 1px solid #647081;
  border-radius: 8px;
  padding-left: 8px;
}

QComboBox:focus {
    border: 1px solid #19BDDE;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    border-left: 0px solid #444;
}

QComboBox::down-arrow {
    image: url(:/FrameFlow/down.svg);
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
  background-color: #171B22;
  border: 1px solid white;
  selection-background-color: #00c853;
  selection-color: white;
  outline: none;
  color: white;
}

QComboBox QAbstractItemView::item {
    padding: 10px 0px;
}

QComboBox QAbstractItemView::item:hover {
  background-color: #2d2d2d;
}

QComboBox QScrollBar:vertical {
  width: 6px;
  background: transparent;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #000000;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #00bcd4;   /* blue filled bar */
    border-radius: 3px;
}

QSlider::add-page:horizontal {
    background: #1c1f24;   /* remaining bar */
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 12px;
    height: 15px;
    background: #ff000000;
    border: 1px solid #00bcd4;
    border-radius: 7px;
    margin: -4px 0;        /* center handle vertically */
}

QSlider::handle:horizontal:hover {
    background: #e0f7fa;
}

#folderSelectorButton {
  border: 1px solid #647081;
  color: #647081;
 border-radius: 7px;
}
</string>
