QSlider::groove:horizontal {
    height: 6px;
    background: #000000;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #00bcd4;   /* blue filled bar */
    border-radius: 3px;
}

QSlider::add-page:horizontal {
    background: #1c1f24;   /* remaining bar */
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 12px;
    height: 15px;
    background: #ff000000;
    border: 2px solid #00bcd4;
    border-radius: 7px;
    margin: -4px 0;        /* center handle vertically */
}

QSlider::handle:horizontal:hover {
    background: #e0f7fa;
}

QLabel {
  color: #7B899D;
}</string>
