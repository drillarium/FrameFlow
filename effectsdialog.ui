  <property name="styleSheet">
   <string notr="true">#mainWidget {
  background: #171B22;
  border: 1px solid white;
  border-radius: 12px;
}

QLabel {
  color: white;
}

#closeButton {
  background: transparent;
}

#aspectRatioLabel, #resolutionLabel, #framerateLabel {
  color: #647081;
}

#resumeWidget {
  background: #181B22;
  border: 1px solid #647081;
  border-radius: 12px;
}

#cancelButton {
  background: #171B22;
  color: white;
  border: 1px solid #647081;
  border-radius: 8px;
}

#cancelButton:hover {
  background-color: #1E2330;
  color: white;
}

#createProjectButton {
  background: #19BDDE;
  color: black;
  border: 1px solid #19BDDE;
  border-radius: 8px;
}

#createProjectButton:hover {
  background-color: #14A8C6;
  color: black;
}

QLineEdit {
  background: #171B22;
  color: white;
  border: 1px solid #647081;
  border-radius: 8px;
  padding-left: 8px;
}

QLineEdit:focus {
    border: 1px solid #19BDDE;
}

QComboBox {
  background: #171B22;
  color: white;
  border: 1px solid #647081;
  border-radius: 8px;
  padding-left: 8px;
}

QComboBox:focus {
    border: 1px solid #19BDDE;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    border-left: 0px solid #444;
}

QComboBox::down-arrow {
    image: url(:/FrameFlow/down.svg);
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
  background-color: #171B22;
  border: 1px solid white;
  selection-background-color: #00c853;
  selection-color: white;
  outline: none;
  color: white;
}

QComboBox QAbstractItemView::item {
    padding: 10px 0px;
}

QComboBox QAbstractItemView::item:hover {
  background-color: #2d2d2d;
}

QComboBox QScrollBar:vertical {
  width: 6px;
  background: transparent;
}

#AfilterPage, #BeffectPage, #COverlayPage {
  background: transparent;
}
</string>
